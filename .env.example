# Django backend root (used by the dev proxy and to build /media URLs).
VITE_BACKEND_URL=https://cinehubsbackend-production.up.railway.app

# Where API calls go. Leave as /api when the host proxies /api to the backend
# (Vite dev server, vercel.json). Set to the full backend URL + /api if you
# host without a proxy — then add this site's origin to WEB_APP_ORIGINS on the backend.
VITE_API_BASE=/api
